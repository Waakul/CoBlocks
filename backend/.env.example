PORT=<PORT> # Port to run the backend on
PUBLIC_BASE_URL=https://your-public-api.example.com # Exact public origin of this backend, used for Scratch Auth callback
CHAT_WEBHOOK_URL=<WEBHOOK-URL> # discord webhook url
ADMIN_USER={"<username>":"<password>"} # Custom ones, Doesnt have to be scratch username and password
ADMIN=[<admin-username-list>] # List of admin users, Has to be scratch usernames
