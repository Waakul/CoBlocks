{
    "name": "CoBlocks: Live Scratch Collaboration",
    "description": "Create Scratch projects together in real time with CoBlocks.",
    "version": "0.3.0",
    "version_name": "0.3.0-pre",
    "icons": {
       "16": "icon16.png",
       "32": "icon32.png",
       "48": "icon48.png",
       "128": "icon128.png"
    },
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches":["https://scratch.mit.edu/projects*"],
            "css":[],
            "js":["injectors/editor.js"]
        },{
            "matches":["https://scratch.mit.edu/mystuff*"],
            "css":[],
            "js":["injectors/mystuff.js"]
        },{
            "matches":["https://scratch.mit.edu/*"],
            "css":["scripts/badge.css"],
            "js":["injectors/all.js"]
        }
    ],
    "background": {
        "service_worker":"background.js"
    },
    "permissions": [
        "storage",
        "cookies"
    ],
    "host_permissions":[
        "https://scratch.mit.edu/*",
        "https://livescratchapi.waakul.com/*"
    ],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "optional_permissions":["notifications"],
    "web_accessible_resources" : [{
        "resources":["/scripts/editor.js", "/scripts/badge.js","/scripts/mystuff.js","/img/CoBlocksIcon.png","/img/CoBlocksLogo.png","/sounds/ping.mp3"],
        "matches":["<all_urls>"]
    }],
    "externally_connectable": {
        "matches": ["https://scratch.mit.edu/*"]
    },
    "action": {
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png"
        },
        "default_popup": "popups/popup.html"
    }
}
