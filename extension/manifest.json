{
  "name": "CoBlocks: Live Scratch Collabs!",
  "description": "Create Scratch projects together in real time with CoBlocks.",
  "version": "0.3.0",
  "version_name": "0.3.0-pre",
  "manifest_version": 3,
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://livescratchapi.waakul.com/apiv2/auth/scratch/complete*"
      ],
      "js": [
        "auth/complete.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scratch.mit.edu/*"
      ],
      "js": [
        "injectors/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://scratch.mit.edu/projects*",
        "https://scratch.mit.edu/create*"
      ],
      "js": [
        "injectors/editor.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://scratch.mit.edu/mystuff*"
      ],
      "js": [
        "injectors/mystuff.js"
      ]
    },
    {
      "matches": [
        "https://scratch.mit.edu/*"
      ],
      "css": [
        "scripts/badge.css"
      ],
      "js": [
        "injectors/all.js"
      ]
    },
    {
      "matches": [
        "https://scratch.mit.edu/*"
      ],
      "js": [
        "injectors/update.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background/socket.io.js",
      "background/auth.js",
      "background/updates.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "cookies",
    "webNavigation",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://scratch.mit.edu/*",
    "https://livescratchapi.waakul.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/editor.js",
        "scripts/badge.js",
        "scripts/mystuff.js",
        "img/CoBlocksIcon.png",
        "img/CoBlocksLogo.png",
        "sounds/ping.mp3",
        "scripts/runtime.js"
      ],
      "matches": [
        "https://scratch.mit.edu/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://scratch.mit.edu/*"
    ]
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_popup": "popups/popup.html"
  },
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "coblocks@waakul.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personalCommunications",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  }
}
